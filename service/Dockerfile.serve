# ITCS355 Lab 3 — serving image
#
# TODO(Lab 3): pin by digest, as you did for the training image in Lab 1.
FROM python:3.11-slim AS builder
ENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1
WORKDIR /build
COPY requirements-serve.txt ./
RUN pip install --prefix=/install -r requirements-serve.txt

FROM python:3.11-slim AS runtime
RUN useradd --create-home --uid 10001 runner
ENV PYTHONUNBUFFERED=1 PYTHONPATH=/app
COPY --from=builder /install /usr/local
WORKDIR /app
COPY --chown=runner:runner service/ ./service/
COPY --chown=runner:runner src/ ./src/
COPY --chown=runner:runner cloudlayer/ ./cloudlayer/
USER runner

EXPOSE 8080
# TODO(Lab 3): your provider expects specific health and predict paths.
#   AWS SageMaker  -> /ping and /invocations
#   Azure ML       -> configurable liveness route on the deployment
#   Vertex AI      -> health and predict routes declared on the Model resource
# Absorb the difference in cloudlayer/, or map the paths here. Do NOT rename the routes
# in service/app.py — that is what makes the image non-portable.
CMD ["uvicorn", "service.app:app", "--host", "0.0.0.0", "--port", "8080", "--workers", "2"]
